{
  "name": "trptools-bot",
  "version": "2.9.2",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "deploy-commands": "bun run src/deploy-commands.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "bun run typecheck && bun test src && bun run worker:check && wrangler deploy",
    "worker:check": "wrangler deploy --dry-run --outdir dist/worker",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@upstash/redis": "^1.39.0",
    "discord-interactions": "^4.4.0",
    "discord.js": "^14.25.1",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "wrangler": "^4.136.3"
  }
}
