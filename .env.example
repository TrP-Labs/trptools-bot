# --- Discord -----------------------------------------------------------------
# The same application as the API uses. The application id doubles as the bot's
# own user id.
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=

# Register slash commands to one server while developing — they appear at once,
# where global commands take up to an hour to propagate. Leave unset in
# production.
DEV_GUILD_ID=

# --- TrP Tools ---------------------------------------------------------------
# Where the API is, from the bot's point of view. On a container network this is
# the service name, not the public URL.
API_URL=http://localhost:3001

# Must match BOT_SERVICE_TOKEN in the API's environment. The bot acts across
# every group at once, so it authenticates as a service rather than as a user.
BOT_SERVICE_TOKEN=

# --- Realtime ----------------------------------------------------------------
# Optional but strongly recommended. Without it the bot cannot find a message it
# posted earlier, so Discord sheets will not follow sign-ups made on the website
# and the end-of-shift cleanup has nothing to clear.
REDIS_URL=redis://localhost:6379

# How often to ask the API which automated actions are due.
SCHEDULER_INTERVAL_SECONDS=30
